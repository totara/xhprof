{
    "name": "totara/xhprof",
    "type": "library",
    "description": "Fork of XHProf for Totara",
    "keywords": ["profiling", "performance"],
    "license": "Apache-2.0",
    "require": {
        "php": ">=8.2.0"
    },
    "autoload": {
        "files": [
            "xhprof_lib/utils/xhprof_lib.php",
            "xhprof_lib/utils/xhprof_runs.php",
            "xhprof_totara.php"
        ]
    },
    "bin": ["bin/xhprofile"],
    "replace": {
        "longxinh/xhprof": "self.version"
    }
}
